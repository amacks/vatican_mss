[%- WRAPPER "wrapper.tt"
 title="Vatican: ${shelfmark}"
 description="${full_description}"
 url="${url}"
 image="${thumbnail_url"
 -%]

<div class="grid-container">
	<div class="grid-x grid-margin-x">
		<div class="header cell">
			<h2>${shelfmark}</h2>
		</div>
	</div>
	<div class="grid-x grid-margin-x">
		<div class="cell small-6 medium-4 large-2">
			<img src="${thumbnail_url}" class="ms_thumbnail">
		</div>
		<div class="cell small-6 medium-8 large-10">
			<dl data-pagefind-body>
				<dt>Shelfmark</dt>
				<dd><a target="_blank" href="${ms_base_url}${shelfmark}">${shelfmark}</a> (<a target="_blank" href="${details_url}">details</a>)</dd>
				<dt>Author</dt>
				<dd>${author}</dd>
				<dt>Title</dt>
				<dd>${title}</dd>
				<dt>Date</dt>
				<dd>${date}</dd>
				<dt>Incipit</td>
				<dd>${incipit}</dd>
				<dt>Notes</dt>
				<dd>${notes_html}</dd>
			</dl>
		</div>
	</div>
<hr>
		<!-- IIIF Browser for ${iiif_url} -->		
<script type="module">
import Tify from 'https://cdn.jsdelivr.net/npm/tify@0.35.0/dist/tify.js'

new Tify({
  container: '#tify',
  manifestUrl: '${iiif_url}',
})
</script>
		<div class="cell small-12" id="tify" style="height: 640px;"></div>
</div>
<div class="grid-container">
	<hr>
		<div class="cell small-6">
			<div class="grid-container">
				<div class="grid-x align-center">
					<nav aria-label="You are here:" role="navigation">
					<ul class="breadcrumbs">
					  <li><a href="/vatican/">Vatican Manuscripts</a></li>
					  <li><a href="/vatican/fonds/${fond_code}">${fond_code}</a></li>
					  <li>${shelfmark}</li>
					</ul>
					</nav>
				</div>
			</div>
		</div>
	</div>
	<hr>
</div>

[% END %]